# Local portable build: ./; Cloudflare Pages: /; GitHub Pages: /your-repository/
VITE_BASE_PATH=./
# Optional stable HTTPS homepage; configure per target, never use a temporary preview URL.
# GitHub Actions supplies it from Pages metadata. Cloudflare Production uses its dashboard value.
VITE_SITE_URL=
# atelier | nord (example configuration, same template)
VITE_SITE_PRESET=atelier
# true | false; false does not create a backend or destination
VITE_DEMO_MODE=true
# Comma-separated: hero,portfolio,about,services,process,contact
VITE_DISABLED_SECTIONS=
